":{"project_id":"xyn-trader-mwi059qr-53f5952a","project_dir":"E:\\Projects_MT5\\XYN_Trader\\manus-slides\\xyn-trader-mwi059qr-53f5952a","active_file":"roadmap_next_steps.html","resource_uri":"manus-resource://manus-slides/deck/xyn-trader-mwi059qr-53f5952a","base_resource_uri":"manus-resource://manus-slides/deck/xyn-trader-mwi059qr-53f5952a","widget_uri":"manus-widget://manus-slides/studio/deck/xyn-trader-mwi059qr-53f5952a","base_widget_uri":"manus-widget://manus-slides/studio/deck/xyn-trader-mwi059qr-53f5952a","version_id":"v-mwi08aop-9657c9d0"},"attachments":[{"type":"addon_resource","resourceUri":"manus-resource://manus-slides/deck/xyn-trader-mwi059qr-53f5952a","title":"XYN Trader — Инвеститорска презентация","contentKind":"slides","icon":"presentation","viewer":{"type":"addon_widget","widgetId":"studio","widgetUri":"manus-widget://manus-slides/studio/deck/xyn-trader-mwi059qr-53f5952a"},"legacySlides":{"manifestUrl":"https://manus-addon-slides.manus.im/api/v1/resource-","title":"XYN Trader — Инвеститорска презентация","directory":"/home/ubuntu/manus-slides/xyn-trader-mwi059qr-53f5952a","outline":[{"id":"cover","title":"XYN Trader — XAUUSD Signal Engine","summary":"Заглавен слайд с името на проекта, positioning statement и визуално представяне на XAUUSD аналитиката. Предназначен да създаде усещане за професионализъм и фокус."},{"id":"thesis","title":"Инвестиционна теза: От поток към предимство","summary":"Защо XYN Trader е нужен сега: превръщане на суровия MT5 поток в структурирано аналитично предимство чрез правила и контролирано обучение."},{"id":"problem","title":"Проблемът: Хаосът в аналитичния workflow","summary":"Описва болката на анализатора: фрагментирани данни, неясна свежест на котировките, субективни сценарии и липса на пътека за обучение от грешките."},{"id":"solution_product","title":"Решението: Единен център за пазарен интелект","summary":"Представяне на Dashboard-а като единен център. Използвай screenshot на Таблото като доказателство за работещо MVP. Показатели: Price, Regime, Scenarios, News."},{"id":"workflow_screens","title":"Екосистемата на XYN Trader","summary":"Четирите стълба на продукта: Табло (контрол), Сигнали (сценарии), Анализ (дълбочина), Новини (контекст). Кратка роля на всеки екран."},{"id":"engine_logic","title":"Signal Engine: Правила, които работят","summary":"Как работи правиловият генератор: H1 свещи, swing зони, EMA20/50, ADX филтрация. Стриктни правила преди AI вероятностите. Изрично споменаване на липсата на инвестиционен съвет."},{"id":"learning_cycle_governance","title":"Мащабируемост чрез контролирано обучение","summary":"Rolling learning store, matured labels, holdout AUC/Brier и изрично човешко одобрение (reviewer promotion) преди активиране на модел."},{"id":"architecture_stack","title":"Модерна архитектура и интеграции","summary":"Лек, но мощен стек: ASP.NET Core 10, Blazor, Python, MT5 Bridge, SQLite, GDELT. Интегриран workflow между три независими услуги."},{"id":"scope_trust","title":"Текущ обхват и защита на потребителя","summary":"Какво работи сега и как се пазим от грешки: no order execution, stale-data notices, heuristic risk scores. Продукт, изграден върху доверие и прозрачност."},{"id":"roadmap_next_steps","title":"Пътят напред: От MVP към Стандарт","summary":"От MVP към Production: engineering milestones, разширяване на активите, подобряване на AI моделите и потенциал за интеграция. Финален апел към инвеститорите."}],"isImageSlides":false,"isPptx":false}}]}}}