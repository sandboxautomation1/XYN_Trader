{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MT5Bridge": {
    "BaseAddress": "http://127.0.0.1:8000/",
    "Symbol": "XAUUSD"
  },
  "Scenarios": {
    "Symbol": "XAUUSD",
    "GeneralTimeframe": "H1",
    "ShortTermTimeframe": "M5",
    "DxySymbol": "DXY",
    "YieldSymbol": "US10Y"
  },
  "AIService": {
    "BaseAddress": "http://127.0.0.1:8001/"
  },
  "AILearning": {
    "CollectionIntervalMinutes": 15,
    "BackfillDays": 365
  },
  "NewsFeed": {
    "Enabled": true,
    "BaseAddress": "https://api.gdeltproject.org/api/v2/doc/doc",
    "Query": "(gold OR XAUUSD OR \"precious metals\" OR \"Federal Reserve\" OR FOMC OR inflation OR CPI OR PCE OR payroll OR \"US dollar\") sourcelang:english",
    "RefreshMinutes": 5,
    "Timespan": "1d",
    "MaxArticles": 12
  },
  "EconomicCalendar": {
    "Enabled": true,
    "RefreshMinutes": 30,
    "BlsContact": ""
  }
}
