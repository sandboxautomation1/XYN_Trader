@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">⌁</span>
            <span class="brand-name">XYN<span>TRADER</span><small>INTELLIGENCE PLATFORM</small></span>
        </a>
        <div class="workspace-switcher">
            <span class="asset-icon">Au</span>
            <span><small>РАБОТНО ПРОСТРАНСТВО</small><strong>XAUUSD <i>/ Злато</i></strong></span>
        </div>
        <div class="nav-caption">ПАЗАР</div>
        <nav class="main-nav" aria-label="Основна навигация">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item"><span class="nav-icon">⌂</span> Табло</NavLink>
            <NavLink href="/signals" class="nav-item"><span class="nav-icon">◎</span> Сигнали</NavLink>
            <NavLink href="/analysis" class="nav-item"><span class="nav-icon">◫</span> Пазарен анализ</NavLink>
            <NavLink href="/price-prediction" class="nav-item"><span class="nav-icon">⌁</span> Прогнози и нива</NavLink>
            <NavLink href="/news" class="nav-item"><span class="nav-icon">▤</span> Новини</NavLink>
            <NavLink href="/calendar" class="nav-item"><span class="nav-icon">◷</span> Икономически календар</NavLink>
            <NavLink href="/backtesting" class="nav-item"><span class="nav-icon">▥</span> Backtesting</NavLink>
        </nav>
        <div class="sidebar-bottom">
            <div class="system-card"><span class="system-icon">◉</span><span><strong>Пазарни данни</strong><small><i class="dot amber"></i> Статусът е в таблото</small></span></div>
            <div class="user-card"><span class="avatar">XY</span><span><strong>Анализатор</strong><small>Локален преглед</small></span></div>
            <div class="sidebar-version">XYN SIGNAL ENGINE <span>v0.1.0</span></div>
        </div>
    </aside>
    <main class="main-area">
        <header class="topbar">
            <div class="breadcrumb"><span>ПАЗАР</span><b>/</b><strong>@CurrentPage</strong></div>
            <div class="connection-pill"><i class="dot amber"></i> XAUUSD · ANALYTICS</div>
        </header>
        <div class="demo-banner"><strong>ПАЗАРНИ FEED-ОВЕ</strong><span>MT5 котировките, техническият анализ и новинарските заглавия се обозначават според връзката и свежестта им.</span></div>
        <section class="page-content">@Body</section>
        <footer class="page-footer">
            <span><i class="dot amber"></i> MT5 market feed · GDELT news · official calendar</span>
            <span>Сигналите са аналитични. Не се изпълняват брокерски поръчки.</span>
        </footer>
    </main>
</div>
<div id="blazor-error-ui" data-nosnippet>
    Възникна грешка. <a href="." class="reload">Презареди</a>
    <span class="dismiss">×</span>
</div>

@code {
    private string CurrentPage => new Uri(Navigation.Uri).AbsolutePath switch
    {
        "/signals" => "Сигнали",
        "/analysis" => "Пазарен анализ",
        "/price-prediction" => "Прогнози и нива",
        "/news" => "Новини",
        "/calendar" => "Икономически календар",
        "/backtesting" => "Backtesting",
        _ => "Табло"
    };

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
