    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RefreshMarketAsync(), RefreshNewsAsync(), RefreshCalendarAsync(), RefreshPositionsAsync());
        _ = PollLatestTickAsync(_lifetime.Token);
        _ = PollNewsAsync(_lifetime.Token);
        _ = PollCalendarAsync(_lifetime.Token);
        _ = PollPositionsAsync(_lifetime.Token);
        _ = PollScenarioAssessmentsAsync(_lifetime.Token);
    }

    private async Task RefreshNewsAsync(CancellationToken cancellationToken = default)
    {
        NewsData = await NewsFeed.GetLatestAsync(cancellationToken: cancellationToken);
    }

    private async Task PollNewsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(NewsFeed.RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var result = await NewsFeed.GetLatestAsync(cancellationToken: cancellationToken);
                await InvokeAsync(() =>
                {
                    NewsData = result;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task PollPositionsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var result = await PositionReview.GetReviewsAsync(cancellationToken);
                await InvokeAsync(() =>
                {
                    PositionData = result;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task PollScenarioAssessmentsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await RefreshScenarioAssessmentAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshScenarioAssessmentAsync(CancellationToken cancellationToken)
    {
        bool entered;
        try
        {
            entered = await ScenarioAssessmentRefreshGate.WaitAsync(0, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!entered)
            return;

        try
        {
            var report = await ScenarioAssessment.AssessAsync(cancellationToken);
            await InvokeAsync(() =>
            {
                ScenarioReport = report;
                ScenarioAssessmentError = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            await InvokeAsync(() =>
            {
                ScenarioAssessmentError = "оценката е недостъпна";
                StateHasChanged();
            });
        }
        finally
        {
            ScenarioAssessmentRefreshGate.Release();
        }
    }

    private async Task RefreshCalendarAsync(CancellationToken cancellationToken = default)
    {
        CalendarData = await EconomicCalendar.GetLatestAsync(days: 2, cancellationToken: cancellationToken);
