            return;

        await ExecutePositionActionAsync(
            review.Position.Ticket,
            () => PositionReview.ClosePositionAfterReviewAsync(review.Position.Ticket, _lifetime.Token));
    }

    private async Task<bool> ExecutePositionActionAsync(long ticket, Func<Task<PositionActionResult>> action)
    {
        ActionInProgressTicket = ticket;
        PositionActionNotice = null;
        var succeeded = false;
        try
        {
            var result = await action();
            PositionActionSucceeded = result.Succeeded;
            PositionActionNotice = result.Message;
            if (result.Succeeded)
            {
                succeeded = true;
                await RefreshPositionsAsync();
            }
        }
        finally
        {
            ActionInProgressTicket = null;
        }
        return succeeded;
    }

