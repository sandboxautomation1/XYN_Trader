    private static string FormatPrice(decimal price, int digits) =>
        price.ToString($"N{Math.Clamp(digits, 0, 8)}", CultureInfo.CurrentCulture);

    private static string FormatMoney(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2", CultureInfo.CurrentCulture) :
            $"{amount.ToString("N2", CultureInfo.CurrentCulture)} {currency}";

    private IReadOnlyList<string> GetPositionContextNotes(OpenPositionReview review)
    {
        var notes = new List<string>();
        var symbol = review.Position.Symbol;
        var isGold = symbol.Contains("XAU", StringComparison.OrdinalIgnoreCase) ||
            symbol.Contains("GOLD", StringComparison.OrdinalIgnoreCase);
        var isUsdRelated = isGold || symbol.Contains("USD", StringComparison.OrdinalIgnoreCase);

        if (isGold)
        {
            if (NewsData is { Available: true } news)
            {
                var freshness = news.IsStale ? "остарели" : "актуални";
                notes.Add($"Новини за злато: {news.SentimentLabel}; риск {news.RiskLevel} ({news.RiskScore}/100), {freshness}.");
            }
            else
            {
                notes.Add("Новинарският контекст за злато не е наличен.");
            }
        }

        if (isUsdRelated)
        {
            if (CalendarData is { Available: true } calendar)
            {
                var now = DateTimeOffset.UtcNow;
                var nextEvents = calendar.Events
                    .Where(item => item.Impact == "Високо" &&
                        (item.ScheduledAtUtc is { } scheduled
                            ? scheduled >= now && scheduled <= now.AddHours(24)
                            : item.EventDate >= DateOnly.FromDateTime(now.UtcDateTime) && item.EventDate <= DateOnly.FromDateTime(now.AddDays(1).UtcDateTime)))
                    .OrderBy(item => item.ScheduledAtUtc ?? new DateTimeOffset(item.EventDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero))
                    .Take(2)
                    .ToArray();
                if (nextEvents.Length > 0)
                {
                    var eventSummary = string.Join("; ", nextEvents.Select(item =>
                        item.ScheduledAtUtc is { } scheduled
                            ? $"{item.Title} · {scheduled:HH:mm} UTC"
                            : $"{item.Title} · {item.EventDate:dd.MM}"));
                    notes.Add($"Предстоящо събитие с високо въздействие: {eventSummary}{(calendar.IsStale ? " (календарът е частично остарял)" : string.Empty)}.");
                }
                else
                {
                    notes.Add(calendar.IsStale
                        ? "Няма потвърдени високорискови събития в наличния, частично остарял календар."
                        : "Няма насрочено събитие с високо въздействие през следващите 24 часа.");
                }
            }
            else
            {
                notes.Add("Икономическият календар не е наличен.");
            }
        }

        return notes;
    }

