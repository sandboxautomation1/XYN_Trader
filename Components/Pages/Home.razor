@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject Mt5MarketDataProvider MarketProvider
@inject TechnicalAnalysisService TechnicalAnalysis
@inject LiveSignalService SignalService
@inject ScenarioAssessmentService ScenarioAssessment
@inject NewsFeedService NewsFeed
@inject EconomicCalendarService EconomicCalendar
@inject PositionReviewService PositionReview
@inject PositionProfitTargetStore PositionProfitTargets
@inject IJSRuntime JS

<PageTitle>Табло — XYN Trader</PageTitle>

@{
    var liveMarket = LiveMarket?.Snapshot;
    var analysis = liveMarket is null ? null : TechnicalAnalysis.Analyze(liveMarket, SelectedTimeframe);
    var signals = (CandidateGeneration?.Candidates ?? []).Take(3).ToArray();
    IReadOnlyList<Candle> chartCandles = liveMarket?.Candles.TakeLast(60).ToArray() ?? [];
}

<div class="page-heading">
  <div>
    <div class="eyebrow">
      <span></span> XAUUSD / ПАЗАРЕН ОБЗОР
    </div>
    <h1>Пазарен обзор <span></span>
    </h1>
    <p>Котировка и сценарии от MetaTrader 5</p>
  </div>
  <button class="refresh-button" @onclick="RefreshMarketAsync" disabled="@IsRefreshing">@(IsRefreshing ? "Обновяване…" : "Обнови котировката")</button>
</div>
<section class="market-status-panel @StatusClass" role="status" aria-live="polite">
    <div class="market-status-main">
        <i class="dot @StatusDotClass"></i>
        <div>
            <strong>Пазарни данни: @StatusLabel</strong>
            <span>@StatusDescription</span>
        </div>
    </div>
    <div class="market-metadata">
        <span>Източник <strong>@(LiveMarket?.Source ?? "MetaTrader 5")</strong></span>
        <span>Котировка UTC <strong>@(liveMarket?.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "недостъпна")</strong></span>
        <span>Свежест <strong>@FreshnessLabel</strong></span>
    </div>
</section>

<section class="metric-grid signal-summary-grid" aria-label="Обобщение на сигналите и потвърдените сценарии">
    <article class="metric-card">
        <div class="metric-label">АКТИВНИ СИГНАЛИ</div>
        <div class="metric-value positive">@ActiveSignalCountText</div>
        <div class="metric-foot"><span>Статус „Активен“</span><span>@SignalDataLabel</span></div>
    </article>
    <article class="metric-card">
        <div class="metric-label">СИГНАЛИ, ЧАКАЩИ ВХОД</div>
        <div class="metric-value">@WaitingEntryCountText</div>
        <div class="metric-foot"><span>Статус „Чака вход“</span><span>@SignalDataLabel</span></div>
    </article>
    <article class="metric-card">
        <div class="metric-label">ПОТВЪРДЕНИ СЦЕНАРИИ</div>
        <div class="metric-value positive">@ConfirmedScenarioCountText</div>
        <div class="metric-foot"><span>@ScenarioCountFoot</span><span>MT5</span></div>
    </article>
</section>

<section class="metric-grid" aria-label="Пазарни показатели">
    <article class="metric-card price-card">
        <div class="metric-label">XAUUSD / USD <span>METATRADER 5</span></div>
        @if (liveMarket is not null)
        {
            <div class="price-line"><strong>@liveMarket.Price.ToString("N2")</strong><b class="@(liveMarket.ChangePercent >= 0 ? "positive" : "negative")">@(liveMarket.ChangePercent >= 0 ? "↗ +" : "↘ ")@liveMarket.ChangePercent.ToString("0.00")%</b></div>
            <div class="metric-foot"><span>Цена към UTC @liveMarket.UpdatedAtUtc.ToString("HH:mm")</span><span>@FreshnessLabel</span></div>
        }
        else
        {
            <div class="price-line"><strong class="unavailable-value">—</strong></div>
            <div class="metric-foot"><span>Няма валидна live котировка</span><span>недостъпна</span></div>
        }
    </article>
    <article class="metric-card"><div class="metric-label">ПАЗАРЕН РЕЖИМ · MT5</div><div class="metric-value">@(analysis?.Regime ?? "Няма данни")</div><div class="metric-foot"><span>Технически баланс</span><span>@(analysis is null ? "—" : $"{analysis.TechnicalScore}/100")</span></div></article>
    <article class="metric-card"><div class="metric-label">СЦЕНАРИИ · RULES</div><div class="metric-value">@(CandidateGeneration?.Available == true ? CandidateGeneration.Candidates.Count.ToString("00") : "—")</div><div class="metric-foot"><span>@(CandidateGeneration?.Available == true ? "H1 swing-zones" : "няма генератор")</span><span>@(CandidateGeneration?.PolicyVersion ?? "неактивен")</span></div></article>
    <article class="metric-card"><div class="metric-label">НОВИНАРСКА АКТИВНОСТ</div><div class="metric-value risk-value"><i class="dot @NewsRiskTone"></i>@(NewsData is { Available: true } ? NewsData.RiskLevel : "Недостъпна")</div><div class="metric-foot"><span>@(NewsData?.Articles.Count ?? 0) заглавия · 24ч</span><span>@(NewsData?.RiskScore ?? 0)/100</span></div></article>
</section>

<section class="panel positions-panel" aria-label="Отворени позиции от MetaTrader 5">
    <div class="panel-header">
        <div>
            <div class="panel-kicker">ОТВОРЕНИ СДЕЛКИ · LIVE MT5</div>
            <h2>Анализ на позиции <span class="position-count">@(PositionData?.Reviews.Count ?? 0)</span></h2>
        </div>
        <button class="position-refresh-button" @onclick="RefreshPositionsAsync" disabled="@IsRefreshingPositions">
            @(IsRefreshingPositions ? "Обновяване…" : "Обнови позиции")
        </button>
    </div>
    <div class="position-disclaimer">
        Ценовите SL и TP по-долу се променят директно в MT5. Праговете по сума са отделна функция на приложението: при достигането им се изпраща пазарна заявка за затваряне, докато приложението и MT5 bridge са включени.
        @if (PositionData?.RetrievedAtUtc is { } positionsUpdated)
        {
            <span> · Проверено @positionsUpdated.ToString("HH:mm:ss 'UTC'")</span>
        }
    </div>
    @if (PositionActionNotice is not null)
    {
        <div class="position-action-notice @(PositionActionSucceeded ? "success" : "error")" role="status">@PositionActionNotice</div>
    }
    @if (PositionData is null && IsRefreshingPositions)
    {
        <div class="empty-state position-empty"><strong>Зареждане на отворените позиции…</strong><span>Четат се позициите и H1 данните от MT5.</span></div>
    }
    else if (PositionData is { Available: false } unavailable)
    {
        <div class="empty-state position-empty"><strong>Позициите не са достъпни</strong><span>@unavailable.Message</span></div>
    }
    else if (PositionData is { Reviews.Count: 0 })
    {
        <div class="empty-state position-empty"><strong>Няма отворени позиции</strong><span>Когато MT5 има активни сделки, анализът им ще се появи тук.</span></div>
    }
    else if (PositionData is { Available: true } openPositions)
    {
        <div class="position-list">
            @foreach (var review in openPositions.Reviews)
            {
                var position = review.Position;
                <article class="position-card @AdviceClass(review.Advice.Kind)">
                    <div class="position-card-header">
                        <div class="position-identity">
                            <strong>@position.Symbol</strong>
                            <span class="position-side @(position.Type == "BUY" ? "buy" : "sell")">@position.Type</span>
                            <small>Билет #@position.Ticket</small>
                        </div>
                        <span class="position-advice @AdviceClass(review.Advice.Kind)">@review.Advice.Title</span>
                    </div>
                    <div class="position-metrics">
                        <div><span>ОБЕМ</span><strong>@position.Volume.ToString("N2")</strong></div>
                        <div><span>ВХОД</span><strong>@FormatPrice(position.PriceOpen, position.Digits)</strong></div>
                        <div><span>ТЕКУЩА</span><strong>@FormatPrice(position.PriceCurrent, position.Digits)</strong></div>
                        <div><span>ПЕЧАЛБА / ЗАГУБА</span><strong class="@(position.Profit >= 0 ? "positive" : "negative")">@FormatMoney(position.Profit, openPositions.AccountCurrency)</strong></div>
                        <div><span>STOP LOSS</span><strong>@(position.StopLoss > 0m ? FormatPrice(position.StopLoss, position.Digits) : "няма")</strong></div>
                        <div><span>TAKE PROFIT</span><strong>@(position.TakeProfit > 0m ? FormatPrice(position.TakeProfit, position.Digits) : "няма")</strong></div>
                    </div>
                    @{
                        var protectionForm = GetPositionProtectionForm(position);
                    }
                    <div class="position-protection-editor" aria-label="Ценови Stop Loss и Take Profit в MT5">
                        <div class="position-editor-heading">
                            <strong>Ценови нива в MT5</strong>
                            <span>Празно поле или 0 премахва съответното ниво.</span>
                        </div>
                        <label>
                            <span>STOP LOSS · цена</span>
                            <input type="number" min="0" step="@GetPriceStep(position.Digits)"
                                   @bind="protectionForm.StopLossText" @bind:event="oninput"
                                   disabled="@(ActionInProgressTicket is not null)"
                                   aria-label="Ценови Stop Loss за позиция @position.Ticket" />
                        </label>
                        <label>
                            <span>TAKE PROFIT · цена</span>
                            <input type="number" min="0" step="@GetPriceStep(position.Digits)"
                                   @bind="protectionForm.TakeProfitText" @bind:event="oninput"
                                   disabled="@(ActionInProgressTicket is not null)"
                                   aria-label="Ценови Take Profit за позиция @position.Ticket" />
                        </label>
                        <button class="position-action-button save-protection"
                                @onclick="() => SavePositionProtectionAsync(review)"
                                disabled="@(ActionInProgressTicket is not null)">
                            @(ActionInProgressTicket == position.Ticket ? "Промяна…" : "Задай SL / TP")
                        </button>
                    </div>
                    @{
                        var limitForm = GetPositionLimitForm(position.Ticket);
                        var activeLimits = PositionProfitTargets.Get(position.Ticket);
                    }
                    <div class="position-limit-editor" aria-label="Автоматично затваряне по сума">
                        <div class="position-editor-heading">
                            <strong>Автоматично затваряне по P/L</strong>
                            <span>Суми във валутата на MT5 сметката.</span>
                        </div>
                        <label>
                            <span>TAKE PROFIT · @LimitCurrency(openPositions.AccountCurrency)</span>
                            <input type="number" min="0" step="any" inputmode="decimal" placeholder="напр. 1000"
                                   @bind="limitForm.TakeProfitText" @bind:event="oninput"
                                   aria-label="Take Profit сума за позиция @position.Ticket" />
                        </label>
                        <label>
                            <span>STOP LOSS · @LimitCurrency(openPositions.AccountCurrency)</span>
                            <input type="number" min="0" step="any" inputmode="decimal" placeholder="напр. 100"
                                   @bind="limitForm.StopLossText" @bind:event="oninput"
                                   aria-label="Stop Loss сума за позиция @position.Ticket" />
                        </label>
                        <button class="position-action-button save-limits"
                                @onclick="() => SetPositionProfitLimitsAsync(position.Ticket)"
                                disabled="@(ActionInProgressTicket is not null)">
                            @(ActionInProgressTicket == position.Ticket ? "Запазване…" : "Задай")
                        </button>
                        <span class="position-limit-status">
                            @if (activeLimits is null)
                            {
                                <text>Автоматичните прагове не са зададени.</text>
                            }
                            else
                            {
                                <text>Активно затваряне: TP @(activeLimits.TakeProfitAmount is { } tp ? FormatMoney(tp, openPositions.AccountCurrency) : "изкл.") · SL @(activeLimits.StopLossAmount is { } sl ? FormatMoney(sl, openPositions.AccountCurrency) : "изкл.")</text>
                            }
                        </span>
                    </div>
                    <div class="position-review-body">
                        <div class="position-review-summary">
                            <strong>@review.Advice.Title</strong>
                            <span>@review.Advice.Reason</span>
                            @if (review.Advice.Kind == PositionAdviceKind.TightenStop && review.Advice.SuggestedStopLoss is { } suggestedStop)
                            {
                                <span class="suggested-stop">Предложен SL: <b>@FormatPrice(suggestedStop, position.Digits)</b></span>
                            }
                            @foreach (var contextNote in GetPositionContextNotes(review))
                            {
                                <span class="position-context-note">Контекст · @contextNote</span>
                            }
                        </div>
                        <div class="position-review-context">
                            @if (review.Analysis is { } positionAnalysis)
                            {
                                <span>H1 баланс <b>@positionAnalysis.TechnicalScore/100</b></span>
                                <span>Режим <b>@positionAnalysis.Regime</b></span>
                                <span>Свежест <b class="@(review.Freshness == MarketFreshness.Fresh ? "positive" : "negative")">@(review.Freshness == MarketFreshness.Fresh ? "свежи" : "остарели")</b></span>
                            }
                            else
                            {
                                <span>@(review.DataMessage ?? "Няма технически данни за анализа.")</span>
                            }
                            <span>Отворена @position.OpenedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        </div>
                    </div>
                    @if (review.Advice.Kind == PositionAdviceKind.TightenStop && review.Advice.SuggestedStopLoss is { } stopToApply)
                    {
                        <div class="position-actions">
                            <button class="position-action-button apply-stop" @onclick="() => ApplyStopLossAsync(review)" disabled="@(ActionInProgressTicket is not null)">
                                @(ActionInProgressTicket == position.Ticket ? "Проверка и изпълнение…" : $"Потвърди SL {FormatPrice(stopToApply, position.Digits)}")
                            </button>
                        </div>
                    }
                    else if (review.Advice.Kind == PositionAdviceKind.ConsiderClose)
                    {
                        <div class="position-actions">
                            <button class="position-action-button close-position" @onclick="() => ClosePositionAsync(review)" disabled="@(ActionInProgressTicket is not null)">
                                @(ActionInProgressTicket == position.Ticket ? "Проверка и изпълнение…" : "Потвърди затваряне")
                            </button>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

<section class="dashboard-grid">
    <article class="panel chart-panel">
        <div class="panel-header">
            <div><div class="panel-kicker">@(liveMarket is null ? "MT5 ГРАФИКА · НЕДОСТЪПНА" : $"METATRADER 5 · {FreshnessLabel.ToUpperInvariant()}")</div><div class="chart-title"><strong>XAUUSD</strong>@if (liveMarket is not null) { <span>@liveMarket.Price.ToString("N2")</span> }</div></div>
            <div class="timeframe-switch">
                @foreach (var timeframe in Timeframes)
                {
                    <button class="@(SelectedTimeframe == timeframe ? "selected" : "")" @onclick="() => SelectTimeframeAsync(timeframe)" disabled="@IsRefreshing" aria-pressed="@(SelectedTimeframe == timeframe)">@timeframe</button>
                }
            </div>
        </div>
        @if (liveMarket is null)
        {
            <div class="market-chart-unavailable"><strong>Няма live графика</strong><span>Котировката и свещите не са налични. Демонстрационни стойности няма да бъдат показани като live.</span></div>
        }
        else
        {
            <div class="chart-legend"><span><i class="legend-candle"></i> Свещи · MetaTrader 5</span><span><i class="legend-line"></i> EMA 8</span></div>
            <div class="chart-wrap">
                <svg viewBox="0 0 720 250" role="img" aria-label="Котировка и свещи от MetaTrader 5, времева рамка @SelectedTimeframe, към @liveMarket.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'").">
                    @foreach (var price in GetAxisPrices(chartCandles))
                    {
                        <line x1="5" x2="663" y1="@Y(price)" y2="@Y(price)" class="grid-line" />
                        <ChartText X="670" Y="@(Y(price) + 3)" CssClass="axis-label" Text="@(price.ToString("N2"))" />
                    }
                    @for (var index = 0; index < chartCandles.Count; index++)
                    {
                        var candle = chartCandles[index];
                        var candleStep = 658d / chartCandles.Count;
                        var x = 5 + index * candleStep + candleStep / 2;
                        var top = Y(Math.Max(candle.Open, candle.Close));
                        var bottom = Y(Math.Min(candle.Open, candle.Close));
                        <g class="@(candle.Close >= candle.Open ? "candle-up" : "candle-down")">
                            <line x1="@x" x2="@x" y1="@Y(candle.High)" y2="@Y(candle.Low)" />
                            <rect x="@(x - candleStep * 0.3)" y="@top" width="@(candleStep * 0.6)" height="@Math.Max(2, bottom - top)" />
                        </g>
                    }
                    <path d="@EmaPath(chartCandles)" class="ema-line" />
                    <line x1="5" x2="663" y1="@Y(liveMarket.Price)" y2="@Y(liveMarket.Price)" class="price-dash" />
                    <rect x="666" y="@(Y(liveMarket.Price) - 9)" width="50" height="18" rx="3" class="price-tag-bg" />
                    <ChartText X="669" Y="@(Y(liveMarket.Price) + 3)" CssClass="price-tag-text" Text="@(liveMarket.Price.ToString("N2"))" />
                    @foreach (var (label, index) in ChartLabels.Select((label, index) => (label, index)))
                    {
                        <ChartText X="@(5 + index * 108)" Y="246" CssClass="axis-label" Text="@label" />
                    }
                </svg>
            </div>
            <div class="chart-foot"><span>@liveMarket.Candles.Count свещи · @SelectedTimeframe</span><span>UTC · @liveMarket.UpdatedAtUtc.ToString("HH:mm")</span></div>
        }
    </article>

    <article class="panel latest-signals">
        <div class="panel-header"><div><div class="panel-kicker">H1 SWING-ZONES · POLICY</div><h2>Сценарии</h2></div><a href="/signals">Всички →</a></div>
        @foreach (var signal in signals)
        {
            <a class="signal-row" href="/signals">
                <span class="direction-mark @(signal.Direction == "BUY BELOW" ? "buy" : "sell")">@(signal.Direction == "BUY BELOW" ? "↘" : "↗")</span>
                <span class="signal-copy"><strong>@(signal.EntryOrderType ?? (signal.Direction == "BUY BELOW" ? "BUY LIMIT" : "SELL LIMIT")) <small class="status @signal.Status.ToLowerInvariant()">@signal.Status</small></strong><span>@signal.SignalId · @signal.Timeframe · @signal.HorizonHours h</span></span>
                <span class="signal-prob">
                    <strong>@((signal.EntryPrice ?? (signal.EntryLow + signal.EntryHigh) / 2m).ToString("N2"))</strong>
                    <small>цена входа · зона @signal.EntryLow.ToString("N2")–@signal.EntryHigh.ToString("N2")</small>
                    @if (signal.ModelProbabilityPositiveOutcome is { } modelProbability)
                    {
                        <small>AI TP1 @modelProbability.ToString("P0") · @signal.ModelOutcomeHorizonHours h</small>
                    }
                </span>
            </a>
        }
        @if (signals.Length == 0)
        {
            <div class="model-note"><span>✦</span><div><strong>@(CandidateGeneration?.Available == false ? "Генераторът не е наличен" : CandidateGeneration is null ? "Зареждане на сценарии…" : "NEUTRAL · няма валиден setup")</strong><small>@(CandidateGeneration?.Message ?? "Сценариите се изчисляват от H1 свещите.")</small></div></div>
        }
        else
        {
            <div class="model-note"><span>✦</span><div><strong>Setup по правила · AI оценка TP1 преди SL</strong><small>@(CandidateGeneration?.PolicyVersion) · модел @CandidateGeneration?.ModelOutcomeHorizonHours h · @CandidateGeneration?.AsOfUtc?.ToString("HH:mm 'UTC'")</small></div></div>
        }
    </article>

    <article class="panel news-feed-panel">
        <div class="panel-header"><div><div class="panel-kicker">НОВИНИ · @NewsFeedService.SourceName</div><h2>Злато и макроикономика</h2></div><a href="/news">Всички →</a></div>
        @if (NewsData is not { Available: true } news)
        {
            <div class="empty-state news-empty"><strong>Новинарският feed не е достъпен</strong><span>@(NewsData?.Message ?? "Зареждане на заглавия…")</span></div>
        }
        else if (news.Articles.Count == 0)
        {
            <div class="empty-state news-empty"><strong>Няма релевантни заглавия</strong><span>Рискът остава неизвестен, докато feed-ът няма статии.</span></div>
        }
        else
        {
            @foreach (var article in news.Articles.Take(4))
            {
                <a class="news-item" href="@article.Url" target="_blank" rel="noopener noreferrer">
                    <strong>@article.Title</strong>
                    <span>@article.Source · @article.PublishedAtUtc.ToString("HH:mm 'UTC'") <b class="@article.ImpactTone">@article.Impact</b></span>
                </a>
            }
            <div class="analysis-foot"><span>@news.RiskSummary</span><span>@(news.IsStale ? "Запазени данни · остарели" : $"Обновено {news.UpdatedAtUtc?.ToString("HH:mm 'UTC'")}")</span></div>
        }
    </article>

    <article class="panel indicator-panel">
        <div class="panel-header"><div><div class="panel-kicker">ТЕХНИЧЕСКА КАРТИНА · LIVE MT5</div><h2>Индикатори</h2></div><span class="timeframe-chip">@SelectedTimeframe</span></div>
        <div class="indicator-grid">
            @if (analysis is { } liveAnalysis)
            {
                @foreach (var indicator in liveAnalysis.Indicators.Take(4))
                {
                    <div class="indicator"><div><span>@indicator.Name</span><strong class="@indicator.Tone">@indicator.Value</strong></div><div class="indicator-track"><i class="@indicator.Tone" style="width: @(indicator.StrengthPercent)%"></i></div><small>@indicator.State</small></div>
                }
            }
            else
            {
                <div class="market-chart-unavailable"><strong>Няма индикатори</strong><span>Свържете MT5, за да се изчислят стойностите от live свещите.</span></div>
            }
        </div>
        <div class="analysis-foot"><span>Изчислени от MT5 OHLC и обновявани с текущия тик.</span><a href="/analysis">Подробен анализ →</a></div>
    </article>
</section>

@code {
    private static readonly string[] Timeframes = ["M1", "M5", "M15", "M30", "H1", "H4", "D1"];
    private static readonly decimal[] AxisPrices = [2700, 2682, 2664, 2646, 2628];
    private IReadOnlyList<Candle> ChartCandles => LiveMarket?.Snapshot?.Candles.TakeLast(60).ToArray() ?? [];
    private string[] ChartLabels
    {
        get
        {
            var chartCandles = ChartCandles;
            if (chartCandles.Count == 0)
                return [];
            var count = Math.Min(7, chartCandles.Count);
            return Enumerable.Range(0, count)
                .Select(index => chartCandles[index * (chartCandles.Count - 1) / Math.Max(1, count - 1)])
                .Select(candle => SelectedTimeframe == "D1"
                    ? candle.TimeUtc.ToString("dd.MM")
                    : candle.TimeUtc.ToString("HH:mm"))
                .ToArray();
        }
    }
    private string SelectedTimeframe { get; set; } = "H1";
    private MarketDataResult? LiveMarket { get; set; }
    private MarketTick? LatestTick { get; set; }
    private CandidateGenerationResult? CandidateGeneration { get; set; }
    private ScenarioAssessmentReport? ScenarioReport { get; set; }
    private string? ScenarioAssessmentError { get; set; }
    private NewsFeedSnapshot? NewsData { get; set; }
    private EconomicCalendarSnapshot? CalendarData { get; set; }
    private PositionReviewsResult? PositionData { get; set; }
    private bool IsRefreshing { get; set; }
    private bool IsRefreshingPositions { get; set; }
    private long? ActionInProgressTicket { get; set; }
    private string? PositionActionNotice { get; set; }
    private bool PositionActionSucceeded { get; set; }
    private readonly Dictionary<long, PositionLimitForm> PositionLimitForms = [];
    private readonly Dictionary<long, PositionProtectionForm> PositionProtectionForms = [];
    private readonly SemaphoreSlim ScenarioAssessmentRefreshGate = new(1, 1);

    private int? ActiveSignalCount => CandidateGeneration is { Available: true } generation
        ? generation.Candidates.Count(signal => signal.Status == "TRIGGERED")
        : null;

    private int? WaitingEntryCount => CandidateGeneration is { Available: true } generation
        ? generation.Candidates.Count(signal => signal.Status == "CREATED" && !IsLiveEntryReached(signal))
        : null;

    private int? ConfirmedScenarioCount => ScenarioReport is not null
        ? ScenarioReport!.Scenarios.Count(scenario =>
            string.Equals(scenario.Status, "Потвърден сигнал", StringComparison.OrdinalIgnoreCase))
        : null;

    private bool HasScenarioMarketData => ScenarioReport?.Scenarios.Any(scenario => scenario.Price.HasValue) == true;

