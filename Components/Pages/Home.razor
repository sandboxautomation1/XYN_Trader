    private IReadOnlyList<decimal> GetAxisPrices(IReadOnlyList<Candle> candles)
    {
        var high = candles.Max(candle => candle.High);
        var low = candles.Min(candle => candle.Low);
        var step = Math.Max(0.01m, Math.Ceiling((high - low) / 4m));
        var top = Math.Ceiling(high / step) * step;
        _chartMin = Math.Floor(low / step) * step - step * 0.1m;
        _chartMax = top + step * 0.1m;
        return Enumerable.Range(0, 5).Select(index => top - step * index).ToArray();
    }

    private double Y(decimal price) =>
        15 + (double)((ChartMax - price) / (ChartMax - ChartMin)) * 208;

    private decimal ChartMin => _chartMin;
    private decimal ChartMax => _chartMax;
    private decimal _chartMin;
    private decimal _chartMax;
    private string EmaPath(IReadOnlyList<Candle> candles)
    {
        var values = new List<string>(candles.Count);
        var ema = TechnicalAnalysisService.CalculateEma(candles, 8);
        for (var index = 0; index < candles.Count; index++)
        {
            if (ema[index] is not { } value)
                continue;
            var x = 5 + index * (658d / candles.Count) + (658d / candles.Count) / 2;
            values.Add($"{(values.Count == 0 ? "M" : "L")}{x.ToString("0.0", CultureInfo.InvariantCulture)},{Y((decimal)value).ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        return string.Join(' ', values);
    }
