        }
    }

    private void ApplyLiveTick(MarketTick tick)
    {
        LatestTick = tick;
        if (LiveMarket?.Snapshot is not { } snapshot)
            return;
        if (tick.UpdatedAtUtc < snapshot.UpdatedAtUtc)
            return;

        var freshness = Mt5MarketDataProvider.GetFreshness(tick.UpdatedAtUtc, DateTimeOffset.UtcNow);
        var updatedSnapshot = TechnicalAnalysis.ApplyTick(snapshot, tick, SelectedTimeframe);
        LiveMarket = LiveMarket with
        {
            Freshness = freshness,
            Source = Mt5MarketDataProvider.SourceName,
            ReceivedAtUtc = DateTimeOffset.UtcNow,
            Snapshot = updatedSnapshot,
            Message = freshness == MarketFreshness.Stale ? "Последната MT5 котировка е по-стара от 15 минути." : null
        };
    }

    private readonly CancellationTokenSource _lifetime = new();

    private async Task PollLatestTickAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var result = await MarketProvider.GetLatestTickAsync(cancellationToken);
                if (result.Tick is not { } tick)
                    continue;

                await InvokeAsync(() =>
                {
                    ApplyLiveTick(tick);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task RefreshMarketAsync()
    {
        IsRefreshing = true;
        try
        {
            var marketResult = await MarketProvider.GetSnapshotAsync(GetProviderInterval(SelectedTimeframe));
            LiveMarket = marketResult;
            LatestTick = marketResult.Snapshot is { } snapshot
                ? new MarketTick(snapshot.Price, snapshot.Bid ?? snapshot.Price, snapshot.Ask ?? snapshot.Price, snapshot.UpdatedAtUtc)
                : null;
            if (SelectedTimeframe == "H1")
                CandidateGeneration = await SignalService.GenerateFromSnapshotAsync(marketResult);
            _ = RefreshScenarioAssessmentAsync(_lifetime.Token);
        }
        finally
        {
            IsRefreshing = false;
        }
    }

    private bool IsLiveEntryReached(GeneratedSignalCandidate signal)
    {
        var tick = LatestTick;
        if (CandidateGeneration?.IsStale == true || signal.Status != "CREATED" ||
            signal.TimestampUtc.AddHours(signal.HorizonHours) <= DateTimeOffset.UtcNow ||
            tick is null || Mt5MarketDataProvider.GetFreshness(tick.UpdatedAtUtc, DateTimeOffset.UtcNow) != MarketFreshness.Fresh ||
            tick.UpdatedAtUtc < signal.TimestampUtc)
        {
            return false;
        }

        var triggerPrice = (signal.EntryOrderType ?? (signal.Direction == "BUY BELOW" ? "BUY LIMIT" : "SELL LIMIT")) switch
        {
            "BUY LIMIT" when tick.Ask > 0m => tick.Ask,
            "SELL LIMIT" when tick.Bid > 0m => tick.Bid,
            _ => tick.Price
        };

        return triggerPrice >= signal.EntryLow && triggerPrice <= signal.EntryHigh;
    }

    private async Task RefreshPositionsAsync()
    {
        if (IsRefreshingPositions)
            return;

        IsRefreshingPositions = true;
        try
        {
            PositionData = await PositionReview.GetReviewsAsync(_lifetime.Token);
        }
        finally
        {
            IsRefreshingPositions = false;
        }
    }

    private PositionLimitForm GetPositionLimitForm(long ticket)
    {
        if (PositionLimitForms.TryGetValue(ticket, out var form))
            return form;

        var savedLimits = PositionProfitTargets.Get(ticket);
        form = new PositionLimitForm
        {
            TakeProfitText = FormatLimitInput(savedLimits?.TakeProfitAmount),
            StopLossText = FormatLimitInput(savedLimits?.StopLossAmount)
        };
        PositionLimitForms[ticket] = form;
        return form;
    }

    private PositionProtectionForm GetPositionProtectionForm(Mt5OpenPosition position)
    {
        if (PositionProtectionForms.TryGetValue(position.Ticket, out var form))
            return form;

        form = new PositionProtectionForm
        {
            StopLossText = FormatPriceInput(position.StopLoss, position.Digits),
            TakeProfitText = FormatPriceInput(position.TakeProfit, position.Digits)
        };
        PositionProtectionForms[position.Ticket] = form;
        return form;
    }

    private async Task SavePositionProtectionAsync(OpenPositionReview review)
    {
        PositionActionNotice = null;
        if (PositionData is not { Available: true } currentPositions ||
            currentPositions.Reviews.All(item => item.Position.Ticket != review.Position.Ticket))
        {
            PositionActionSucceeded = false;
            PositionActionNotice = "Позицията вече не е налична в MT5. Обнови списъка и опитай отново.";
            return;
        }

        var form = GetPositionProtectionForm(review.Position);
        if (!TryParseProtectionPrice(form.StopLossText, out var stopLoss) ||
            !TryParseProtectionPrice(form.TakeProfitText, out var takeProfit))
        {
            PositionActionSucceeded = false;
            PositionActionNotice = "Въведи валидни положителни цени или остави поле празно, за да премахнеш нивото.";
            return;
        }

        var stopText = stopLoss is { } sl ? FormatPrice(sl, review.Position.Digits) : "премахни";
        var targetText = takeProfit is { } tp ? FormatPrice(tp, review.Position.Digits) : "премахни";
        var accepted = await JS.InvokeAsync<bool>(
            "confirm",
            $"Да променя ли ценовите нива на {review.Position.Symbol}, позиция #{review.Position.Ticket}? SL: {stopText}; TP: {targetText}. Празно поле или 0 премахва съответното ниво.");
        if (!accepted)
            return;

        var result = await ExecutePositionActionAsync(
            review.Position.Ticket,
            () => PositionReview.ModifyPositionProtectionAsync(
                review.Position.Ticket,
                stopLoss,
                takeProfit,
                _lifetime.Token));
        if (result)
            PositionProtectionForms.Remove(review.Position.Ticket);
    }

    private Task SetPositionProfitLimitsAsync(long ticket)
    {
        PositionActionNotice = null;
        if (PositionData is not { Available: true } currentPositions ||
            currentPositions.Reviews.All(review => review.Position.Ticket != ticket))
        {
            PositionActionSucceeded = false;
            PositionActionNotice = "Позицията вече не е налична в MT5. Обнови списъка и опитай отново.";
            return Task.CompletedTask;
        }

        var form = GetPositionLimitForm(ticket);
        if (!TryParseLimit(form.TakeProfitText, out var takeProfit) ||
            !TryParseLimit(form.StopLossText, out var stopLoss))
        {
            PositionActionSucceeded = false;
            PositionActionNotice = "Въведи неотрицателни суми. Поле с 0 или празно поле изключва този праг.";
            return Task.CompletedTask;
        }

        ActionInProgressTicket = ticket;
        try
        {
            PositionProfitTargets.Set(ticket, takeProfit, stopLoss);
            PositionActionSucceeded = true;
            PositionActionNotice = takeProfit is null && stopLoss is null
                ? $"Автоматичните прагове за позиция #{ticket} са изключени."
                : $"Праговете за позиция #{ticket} са зададени: TP {(takeProfit is { } tp ? FormatMoney(tp, currentPositions.AccountCurrency) : "изкл.")}, SL {(stopLoss is { } sl ? FormatMoney(sl, currentPositions.AccountCurrency) : "изкл.")}.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        {
            PositionActionSucceeded = false;
            PositionActionNotice = "Не успях да запазя праговете. Провери достъпа до папката data.";
        }
        finally
        {
            ActionInProgressTicket = null;
        }

        return Task.CompletedTask;
    }

    private static bool TryParseLimit(string value, out decimal? amount)
    {
        amount = null;
        if (string.IsNullOrWhiteSpace(value))
            return true;

        if (!decimal.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var parsed) &&
            !decimal.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.CurrentCulture, out parsed))
            return false;
        if (parsed < 0m)
            return false;

        amount = parsed == 0m ? null : parsed;
        return true;
    }

    private static bool TryParseProtectionPrice(string value, out decimal? price)
    {
        price = null;
        if (string.IsNullOrWhiteSpace(value))
            return true;

        if (!decimal.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var parsed) &&
            !decimal.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.CurrentCulture, out parsed))
            return false;
        if (parsed < 0m)
            return false;

        price = parsed == 0m ? null : parsed;
        return true;
    }

    private static string FormatLimitInput(decimal? amount) =>
        amount?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;

    private static string FormatPriceInput(decimal price, int digits) =>
        price > 0m ? price.ToString($"F{Math.Clamp(digits, 0, 8)}", CultureInfo.InvariantCulture) : string.Empty;

    private static string GetPriceStep(int digits) =>
        Math.Pow(10d, -Math.Clamp(digits, 0, 8)).ToString("0.########", CultureInfo.InvariantCulture);

    private static string LimitCurrency(string? currency) => currency ?? "валута";

    private async Task ApplyStopLossAsync(OpenPositionReview review)
    {
        if (review.Advice.SuggestedStopLoss is not { } stopLoss)
            return;

        var accepted = await JS.InvokeAsync<bool>(
            "confirm",
            $"Да задам ли SL {FormatPrice(stopLoss, review.Position.Digits)} на {review.Position.Symbol}, позиция #{review.Position.Ticket}? Пазарните данни ще бъдат проверени отново преди изпълнение.");
        if (!accepted)
            return;

        await ExecutePositionActionAsync(
            review.Position.Ticket,
            () => PositionReview.ApplySuggestedStopLossAsync(review.Position.Ticket, stopLoss, _lifetime.Token));
    }

    private async Task ClosePositionAsync(OpenPositionReview review)
    {
        var accepted = await JS.InvokeAsync<bool>(
            "confirm",
            $"Потвърждаваш ли затваряне на {review.Position.Type} {review.Position.Symbol}, позиция #{review.Position.Ticket}? P/L от последното MT5 обновяване: {FormatMoney(review.Position.Profit, PositionData?.AccountCurrency)}.");
