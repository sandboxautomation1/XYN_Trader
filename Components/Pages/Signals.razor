@page "/signals"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject LiveSignalService SignalService
@inject CandidateGeneratorClient LearningClient
@inject Mt5MarketDataProvider Mt5

<PageTitle>Сигнали — XYN Trader</PageTitle>

<div class="page-heading">
    <div><div class="eyebrow"><span></span> XAUUSD / СИГНАЛИ ОТ MT5</div><h1>Сценарии<span>.</span></h1><p>Сценарии с хоризонт 24 часа от потвърдени swing зони и затворени H1 свещи от MetaTrader 5. Нов сигнал в същата посока се допуска след 24 часа.</p></div>
    <div class="signal-actions">
        <span class="demo-total"><i class="dot @(Generation?.Available == true && Generation.IsStale == false ? "green" : "amber")"></i> @(IsRefreshing ? "генериране…" : Generation?.Available == true ? $"{FilteredSignals.Count()} сценария{(Generation.IsStale ? " · кеш" : "")}" : "генераторът е недостъпен")</span>
        <button class="refresh-button" @onclick="RefreshAsync" disabled="@IsRefreshing">@(IsRefreshing ? "Обновяване…" : "Обнови")</button>
    </div>
</div>

<section class="stat-grid">
    @foreach (var item in StatusSummary)
    {
        <article class="stat-card"><span><i class="dot @item.Tone"></i> @item.Label</span><strong>@CountStatus(item.Status)</strong><small>@item.Description</small></article>
    }
</section>

<section class="live-quote-strip signals-mt5-status" aria-live="polite">
    @if (LiveQuote is { Tick: { } tick } quote)
    {
        <strong><i class="dot @(quote.Freshness == MarketFreshness.Fresh ? "green" : "amber")"></i> @(quote.Freshness == MarketFreshness.Fresh ? "MT5 СВЪРЗАН" : "MT5 · СТАРА КОТИРОВКА") · XAUUSD @tick.Price.ToString("N2")</strong>
        <span>BID @tick.Bid.ToString("N2") · ASK @tick.Ask.ToString("N2")</span>
        <small>@QuoteStatusText · @FormatLocalTime(tick.UpdatedAtUtc, "HH:mm:ss")</small>
    }
    else
    {
        <strong><i class="dot amber"></i> MT5 НЯМА ВРЪЗКА</strong>
        <small>@(LiveQuote?.Message ?? "Изчакване на котировка от MT5…")</small>
    }
</section>

@if (LiveEntryAlerts.Count > 0)
{
    <section class="live-entry-alert" role="status" aria-live="polite">
        <strong>Цената достигна входна зона</strong>
        @foreach (var alert in LiveEntryAlerts.Values.OrderByDescending(item => item.DetectedAtUtc).Take(3))
        {
            <div class="live-entry-alert-row">
                <span><b>@GetEntryOrderType(alert.Signal)</b> · @alert.Signal.SignalId · цена @alert.TriggerPrice.ToString("N2") в зоната @alert.Signal.EntryLow.ToString("N2")–@alert.Signal.EntryHigh.ToString("N2")</span>
                <small>@FormatLocalTime(alert.DetectedAtUtc, "HH:mm:ss")</small>
                <button type="button" class="live-entry-dismiss" @onclick="() => DismissEntryAlert(alert.Signal.SignalId)" aria-label="Скрий известието">×</button>
            </div>
        }
    </section>
}

@if (Generation?.IsStale == true)
{
    <div class="notice-strip stale-signal-notice"><strong>Няма свежи пазарни данни.</strong> Показани са запазените сценарии от @FormatLocalTime(Generation.GeneratedAtUtc, "yyyy-MM-dd HH:mm"); статусите им отразяват последните налични MT5 свещи.</div>
}

<section class="panel signals-panel">
        <div class="panel-header signals-header">
        <div><div class="panel-kicker">ПРАВИЛОВ ГЕНЕРАТОР · H1 / 24H</div><h2>Сценарии<small>(@FilteredSignals.Count())</small></h2></div>
        <div class="filters">
            <label class="search-input"><span aria-hidden="true">⌕</span><input @bind="Search" placeholder="Търси ID" aria-label="Търси сигнал" /></label>
            <select @bind="Status" aria-label="Филтър по статус"><option value="">Всички статуси</option><option value="CREATED">Чака вход</option><option value="TRIGGERED">Активен</option><option value="CLOSED_TP">Цел достигната</option><option value="CLOSED_SL">Стоп</option><option value="EXPIRED">Изтекъл</option></select>
            <select @bind="Direction" aria-label="Филтър по посока"><option value="">Всички посоки</option><option value="BUY BELOW">BUY LIMIT</option><option value="SELL BELOW">SELL LIMIT</option></select>
            <select @bind="MinimumModelProbability" aria-label="Минимална AI вероятност"><option value="">Всички AI оценки</option><option value="40">AI ≥ 40%</option><option value="50">AI ≥ 50%</option><option value="60">AI ≥ 60%</option></select>
            <select @bind="Date" aria-label="Филтър по дата"><option value="">Всички дати</option><option value="today">Днес</option><option value="yesterday">Вчера</option><option value="older">По-стари</option></select>
        </div>
    </div>

    @if (IsRefreshing && Generation is null)
    {
        <div class="empty-state"><strong>Изчисляване на сценарии…</strong><span>Използват се реални затворени H1 свещи от MetaTrader 5.</span></div>
    }
    else if (FilteredSignals.Any())
    {
        <div class="signal-card-grid">
            @foreach (var signal in FilteredSignals)
            {
                var journalDraft = GetJournalDraft(signal.SignalId);
                var riskResult = GetRiskResult(signal.SignalId);
                var probability = signal.ModelProbabilityPositiveOutcome is { } modelProbability
                    ? Math.Clamp(modelProbability * 100d, 0d, 100d)
                    : (double?)null;

                <article class="signal-card">
                    <div class="signal-card-header">
                        <div class="signal-card-identity">
                            <span class="table-direction @(signal.Direction == "BUY BELOW" ? "positive" : "negative")">@GetEntryOrderType(signal)</span>
                            <strong>@signal.SignalId</strong>
                        </div>
                        <span class="status @(IsLiveEntryReached(signal) ? "live_entry" : signal.Status.ToLowerInvariant())">
                            @(IsLiveEntryReached(signal) ? "ВХОД ДОСТИГНАТ" : GetStatusLabel(signal.Status))
                        </span>
                    </div>

                    <div class="signal-card-meta">
                        <span>@signal.Symbol · @signal.Timeframe · хоризонт @signal.HorizonHours ч.</span>
                        <time>@FormatLocalTime(signal.TimestampUtc, "dd.MM.yyyy · HH:mm")</time>
                    </div>

                    <div class="signal-entry">
                        <div class="signal-entry-price">
                            <small>ЦЕНА НА ВХОД</small>
                            <strong>@GetEntryPrice(signal).ToString("N2")</strong>
                        </div>
                        <div class="signal-entry-zone">
                            <small>ВХОДНА ЗОНА</small>
                            <strong>@signal.EntryLow.ToString("N2") – @signal.EntryHigh.ToString("N2")</strong>
                            <span>Валиден до @FormatLocalTime(GetExpiry(signal), "dd.MM HH:mm")</span>
                        </div>
                    </div>

                    <div class="signal-levels">
                        <div class="signal-level stop-level"><small>СТОП</small><strong>@signal.StopLoss.ToString("N2")</strong></div>
                        <div class="signal-level target-level"><small>TP1</small><strong>@signal.Tp1.ToString("N2")</strong></div>
                        <div class="signal-level target-level"><small>TP2</small><strong>@signal.Tp2.ToString("N2")</strong></div>
                        <div class="signal-level target-level"><small>TP3</small><strong>@signal.Tp3.ToString("N2")</strong></div>
                    </div>

                    <div class="signal-card-metrics">
                        <div class="signal-metric">
                            <small>РИСК / ДОХОД</small>
                            <strong>1 : @signal.Tp1RiskReward.ToString("0.0")</strong>
                            <span>TP2 1 : @signal.Tp2RiskReward.ToString("0.0") · TP3 1 : @signal.Tp3RiskReward.ToString("0.0")</span>
                        </div>
                        <div class="signal-metric signal-ai-metric">
                            <small>AI · TP1 ПРЕДИ SL</small>
                            @if (probability is { } probabilityPercent)
                            {
                                <strong>@probabilityPercent.ToString("0")%</strong>
                                <div class="signal-probability-bar" role="img" aria-label="Лента за AI вероятност">
                                    <span style="@GetProbabilityBarStyle(probabilityPercent)"></span>
                                </div>
                                <span>@(signal.ModelIsCalibrated == true ? "Калибрирана" : "Без калибрация") · @signal.ModelOutcomeHorizonHours ч.</span>
                            }
                            else
                            {
                                <strong>—</strong>
                                <span>@(Generation?.ModelStatus == "policy_mismatch" ? "Policy не съвпада" : "Няма оценка")</span>
                            }
                        </div>
                    </div>

                    <div class="signal-pnl-summary">
                        @if (RiskCalculation?.Calculation is { } pnlAccount)
                        {
                            <div class="signal-pnl-heading">
                                <strong>P/L ЗА ТОЗИ СИГНАЛ</strong>
                                <small>вход @GetEntryPrice(signal).ToString("N2") · сметка @pnlAccount.AccountBalance.ToString("N2") @pnlAccount.AccountCurrency · @pnlAccount.PnlLots.ToString("0.##") lot</small>
                            </div>
                        }
                        @if (riskResult is not null && RiskCalculation?.Calculation is { } calculatedAccount)
                        {
                            <span><small>ЗАГУБА · SL</small><strong class="stop">@FormatSignedMoney(riskResult.StopLossPnl, calculatedAccount.AccountCurrency)</strong><small>@FormatSignedPercent(riskResult.StopLossPnl, calculatedAccount.AccountBalance) от баланса</small></span>
                            <span><small>ПЕЧАЛБА · TP1</small><strong class="target">@FormatSignedMoney(riskResult.Tp1Pnl, calculatedAccount.AccountCurrency)</strong><small>@FormatSignedPercent(riskResult.Tp1Pnl, calculatedAccount.AccountBalance) от баланса</small></span>
                            <span><small>ПЕЧАЛБА · TP2</small><strong class="target">@FormatSignedMoney(riskResult.Tp2Pnl, calculatedAccount.AccountCurrency)</strong><small>@FormatSignedPercent(riskResult.Tp2Pnl, calculatedAccount.AccountBalance) от баланса</small></span>
                            <span><small>ПЕЧАЛБА · TP3</small><strong class="target">@FormatSignedMoney(riskResult.Tp3Pnl, calculatedAccount.AccountCurrency)</strong><small>@FormatSignedPercent(riskResult.Tp3Pnl, calculatedAccount.AccountBalance) от баланса</small></span>
                            @if (riskResult.Status is not ("calculated" or "below_minimum"))
                            {
                                <small class="signal-pnl-warning">@riskResult.Message</small>
                            }
                            else if (riskResult.Status == "below_minimum")
                            {
                                <small class="signal-pnl-warning">P/L за @calculatedAccount.PnlLots.ToString("0.##") lot · @riskResult.Message</small>
                            }
                            else
                            {
                                <small>P/L за @calculatedAccount.PnlLots.ToString("0.##") lot · размер за поръчка @riskResult.VolumeLots.ToString("0.##") lot · лимит риск @riskResult.TargetRiskAmount.ToString("N2") @calculatedAccount.AccountCurrency</small>
                            }
                        }
                        else
                        {
                            <span class="signal-pnl-unavailable">@(riskResult?.Message ?? (IsCalculatingRisk ? "Изчисляване от MT5…" : RiskCalculation?.Message ?? "Няма изчисление от MT5."))</span>
                        }
                    </div>

                    <details class="signal-extra-details">
                        <summary>Технически данни <span>ADX @signal.Adx14.ToString("0.0") · @signal.ZoneTouchCount докосвания на зоната</span></summary>
                        <div>Policy @signal.PolicyVersion · @signal.Timeframe · @signal.HorizonHours часа · генериран @FormatLocalTime(signal.TimestampUtc, "HH:mm:ss")</div>
                    </details>

                    <div class="signal-card-actions">
                        <button class="journal-favorite @(journalDraft.IsFavorite ? "active" : "")"
                                title="@(journalDraft.IsFavorite ? "Премахни от любими" : "Добави в любими")"
                                aria-label="@(journalDraft.IsFavorite ? "Премахни от любими" : "Добави в любими")"
                                @onclick="() => ToggleFavoriteAsync(signal.SignalId)"
                                disabled="@(UserProfile?.Available != true || JournalSavingSignalId == signal.SignalId)">
                            @(journalDraft.IsFavorite ? "★ Любим" : "☆ Любим")
                        </button>
                        <button class="signal-order-button"
                                title="@GetSignalFormDisabledReason(signal)"
                                @onclick="() => ToggleSignalOrderForm(signal)"
                                disabled="@(!CanConfigureSignal(signal) || OpeningSignalIds.Contains(signal.SignalId) || OpenedSignalTickets.ContainsKey(signal.SignalId))">
                            @GetOpenButtonLabel(signal)
                        </button>
                    </div>

                    @if (SignalOrderDrafts.TryGetValue(signal.SignalId, out var orderDraft))
                    {
                        <div class="signal-order-form">
                            <div class="signal-order-form-heading">
                                <strong>Параметри на позицията</strong>
                                <span>@signal.Symbol · @GetMarketOrderType(signal)</span>
                            </div>
                            <div class="signal-order-fields">
                                <label>
                                    <span>Обем (lot)</span>
                                    <input type="number" min="0.01" max="1000" step="0.01" @bind="orderDraft.VolumeLots" disabled="@OpeningSignalIds.Contains(signal.SignalId)" />
                                </label>
                                <label>
                                    <span>Stop Loss</span>
                                    <input type="number" min="0" step="any" @bind="orderDraft.StopLoss" disabled="@OpeningSignalIds.Contains(signal.SignalId)" />
                                </label>
                                <label>
                                    <span>Take Profit (TP1)</span>
                                    <input type="number" min="0" step="any" @bind="orderDraft.TakeProfit" disabled="@OpeningSignalIds.Contains(signal.SignalId)" />
                                </label>
                            </div>
                            <small class="signal-order-form-note">Обемът е изчислен според зададения риск, SL и TP1 са от сигнала. Входът е пазарен; промяната на обема или SL променя риска.</small>
                            <div class="signal-order-form-actions">
                                <button type="button" class="signal-order-cancel" @onclick="() => CloseSignalOrderForm(signal.SignalId)" disabled="@OpeningSignalIds.Contains(signal.SignalId)">Отказ</button>
                                <button type="button" class="signal-order-submit" @onclick="() => OpenSignalPositionAsync(signal, orderDraft)" disabled="@(!CanSubmitSignal(signal, orderDraft) || OpeningSignalIds.Contains(signal.SignalId))" title="@GetOrderSubmitDisabledReason(signal, orderDraft)">
                                    @(OpeningSignalIds.Contains(signal.SignalId) ? "Изпълнение…" : "Потвърди отваряне")
                                </button>
                            </div>
                        </div>
                    }

                    @if (SignalOrderNotices.TryGetValue(signal.SignalId, out var orderNotice))
                    {
                        <small class="signal-order-notice @(orderNotice.Succeeded ? "success" : "error")">@orderNotice.Message</small>
                    }
                    else
                    {
                        <small class="signal-order-hint">Пазарна поръчка · първоначален обем според риска · SL / TP1</small>
                    }

                    <details class="signal-journal-details">
                        <summary>Лична бележка @(journalDraft.Note.Length > 0 ? "· има запис" : "")</summary>
                        <textarea @bind="journalDraft.Note" maxlength="4000" rows="2" placeholder="Добави бележка към този сценарий" aria-label="Лична бележка за @signal.SignalId" disabled="@(UserProfile?.Available != true || JournalSavingSignalId == signal.SignalId)"></textarea>
                        <button class="journal-save" @onclick="() => SaveJournalAsync(signal.SignalId)" disabled="@(JournalSavingSignalId == signal.SignalId)">@(JournalSavingSignalId == signal.SignalId ? "Запис…" : "Запази бележката")</button>
                    </details>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <strong>@EmptyTitle</strong>
            <span>@EmptyMessage</span>
        </div>
    }
    <div class="table-foot">
        <span>@(Generation?.IsStale == true ? $"Последно успешно генериране: {FormatLocalTime(Generation.GeneratedAtUtc, "yyyy-MM-dd HH:mm")}" : Generation?.Available == true ? $"Затворени свещи към {FormatLocalTime(Generation.AsOfUtc, "yyyy-MM-dd HH:mm")} · policy {Generation.PolicyVersion}" : "Сценариите изискват наличен Python генератор.")</span>
        <span>@(Generation?.IsStale == true ? "Кеширани сценарии · пазарният статус може да е остарял" : Generation?.ModelStatus == "loaded" ? $"AI оценка за TP1 преди SL · {Generation.ModelOutcomeHorizonHours}h" : Generation?.ModelStatus == "policy_mismatch" ? "Активният модел не съвпада с версията на правилата" : "Правилов сценарий · няма съвместим активен AI модел")</span>
    </div>
</section>

<div class="notice-strip"><strong>Информация:</strong> BUY LIMIT изчаква спад до зоната за покупка, а SELL LIMIT — покачване до зоната за продажба. Бутонът изпраща пазарна BUY/SELL поръчка само при свежа котировка в зоната; обемът използва зададения риск, стопът е SL, а целта е TP1. Сигналите не изпращат поръчки автоматично.</div>

<details class="signal-disclosure">
    <summary><span>Калкулатор P/L и риск</span><small>Избран lot за P/L · процент риск за изпълнение</small></summary>
<section class="panel risk-calculator-panel">
    <div class="panel-header risk-calculator-header">
        <div><div class="panel-kicker">P/L ПО ЦЕНА И LOT · MT5</div><h2>Калкулатор към сигналите</h2></div>
        <span class="timeframe-chip">@(IsCalculatingRisk ? "ИЗЧИСЛЯВАНЕ…" : RiskCalculation?.Available == true ? "СВЪРЗАН С MT5" : "MT5 НЕДОСТЪПЕН")</span>
    </div>
    <div class="risk-calculator-controls">
        <div class="risk-account-balance">
            <span>БАЛАНС ПО СМЕТКАТА</span>
            <strong>@(RiskCalculation?.Calculation is { } calculation ? $"{calculation.AccountBalance.ToString("N2")} {calculation.AccountCurrency}" : "—")</strong>
            <small>@(RiskCalculation?.Calculation is { } account ? $"Equity {account.AccountEquity.ToString("N2")} {account.AccountCurrency}" : RiskCalculation?.Message ?? "Зареждане от MT5…")</small>
        </div>
        <label class="risk-percent-field">
            <span>Риск за обем на поръчка (% от баланса)</span>
            <input type="number" min="0.01" max="100" step="0.1" @bind="RiskPercentInput" @bind:event="onchange" @bind:after="RefreshRiskCalculationsAsync" aria-label="Риск за обем на поръчка в проценти" />
        </label>
        <label class="risk-percent-field">
            <span>Lot за P/L на всеки сигнал</span>
            <input type="number" min="0.01" max="1000" step="0.01" @bind="PnlLotsInput" @bind:event="onchange" @bind:after="RefreshRiskCalculationsAsync" aria-label="Размер на lot за P/L изчисление" />
        </label>
        <button class="refresh-button risk-recalculate-button" @onclick="RefreshRiskCalculationsAsync" disabled="@IsCalculatingRisk">@(IsCalculatingRisk ? "Изчисляване…" : "Преизчисли")</button>
    </div>
    <div class="risk-calculator-foot">
        <span>@(RiskCalculation?.Calculation is { } summary ? $"P/L е за {summary.PnlLots.ToString("0.##")} lot · риск за поръчка: {(summary.AccountBalance * summary.RiskPercent / 100m).ToString("N2")} {summary.AccountCurrency} · изчислено {FormatLocalTime(summary.CalculatedAtUtc, "HH:mm:ss")}" : RiskCalculation?.Message ?? "Използват се балансът и спецификациите на инструмента от MT5.")</span>
        <span>P/L се смята според инструмента и валутата на сметката в MT5; размерът на поръчката следва отделно зададения риск. Сумите не включват спред, комисиона, суап и приплъзване.</span>
    </div>
</section>
</details>

<details class="signal-disclosure">
    <summary><span>Личен профил и дневник</span><small>@SavedJournalEntries.Count(entry => entry.IsFavorite) любими · @SavedJournalEntries.Count(entry => !string.IsNullOrWhiteSpace(entry.Note)) бележки</small></summary>
<section class="panel user-profile-panel">
    <div class="panel-header user-profile-header">
        <div><div class="panel-kicker">ЛИЧНИ ДАННИ · ОТДЕЛНА SQLITE БАЗА</div><h2>@(UserProfile?.Profile?.DisplayName ?? "Моят дневник")</h2></div>
        @if (UserProfile?.Available == true && UserProfile.Profile is not null)
        {
            <span class="timeframe-chip">@SavedJournalEntries.Count(entry => entry.IsFavorite) любими · @SavedJournalEntries.Count(entry => !string.IsNullOrWhiteSpace(entry.Note)) бележки</span>
        }
    </div>
    <div class="user-profile-copy">
        @(UserProfile?.Available == true
            ? "Любимите сценарии и бележките се пазят локално и не се изтриват при ротация на H1 историята."
            : UserProfile?.Message ?? "Зареждане на личните данни…")
        @if (!string.IsNullOrWhiteSpace(JournalNotice))
        {
            <span class="journal-notice @(JournalNoticeIsError ? "error" : "")">@JournalNotice</span>
        }
    </div>
</section>
@if (SavedJournalEntries.Count > 0)
{
    <section class="panel saved-journal-panel">
        <div class="panel-header saved-journal-header">
            <div><div class="panel-kicker">ПОСТОЯННО ЗАПАЗЕНИ ЛИЧНИ ЗАПИСИ</div><h2>Моят дневник <small>(@SavedJournalEntries.Count)</small></h2></div>
        </div>
        <div class="saved-journal-list">
            @foreach (var entry in SavedJournalEntries)
            {
                <article class="saved-journal-entry">
                    <div class="saved-journal-heading">
                        <strong>@entry.SignalId</strong>
                        <span>@(entry.IsFavorite ? "★ Любим" : "Бележка") · @FormatLearningTime(entry.UpdatedAtUtc)</span>
                        <button class="journal-remove" @onclick="() => DeleteJournalEntryAsync(entry.SignalId)" disabled="@(JournalSavingSignalId == entry.SignalId)">Изтрий</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                    {
                        <p>@entry.Note</p>
                    }
                </article>
            }
        </div>
    </section>
}
</details>

<details class="signal-disclosure">
    <summary><span>Обучение на AI модела</span><small>Състояние на данните, моделите и кандидати за одобрение</small></summary>
<section class="panel learning-panel">
    <div class="panel-header learning-header">
        <div><div class="panel-kicker">САМО-ОБУЧЕНИЕ · РЕАЛНИ MT5 H1 ДАННИ</div><h2>Обучителен цикъл</h2></div>
        <span class="timeframe-chip">@(Learning?.Available == true ? LearningStateLabel : "AI УСЛУГАТА Е НЕДОСТЪПНА")</span>
    </div>
    @if (Learning?.Available != true || Learning.Status is null)
    {
        <div class="learning-message">@(Learning?.Message ?? "Зареждане на обучителния статус…")</div>
    }
    else
    {
        <div class="learning-summary">
            <span><i class="dot @(Learning.Status.StoredCandles >= 100 ? "green" : "amber")"></i> @Learning.Status.StoredCandles / @Learning.Status.MaximumStoredCandles свещи</span>
            <span>Последен прием: @FormatLearningTime(Learning.Status.LastIngestUtc)</span>
            <span>Последен цикъл: @FormatLearningTime(Learning.Status.LastCycleUtc)</span>
            <span>Активен модел: @(Learning.Status.ActiveModels.Count == 0 ? "няма" : string.Join(", ", Learning.Status.ActiveModels))</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Learning.Status.LastError))
        {
            <div class="learning-message">@Learning.Status.LastError</div>
        }
        <div class="learning-horizons">
            @foreach (var horizon in LearningHorizons)
            {
                <article class="learning-horizon">
                    <div><strong>@horizon.Key</strong><span class="@(horizon.Value.TrainingState == "candidate_ready" ? "positive" : "")">@LearningHorizonLabel(horizon.Value)</span></div>
                    <p>@horizon.Value.MaturedLabels / @horizon.Value.MinimumLabels узрели резултата · @horizon.Value.PositiveLabels положителни</p>
                    @if (horizon.Value.HoldoutAuc is not null)
                    {
                        <p>Holdout AUC @horizon.Value.HoldoutAuc.Value.ToString("0.000") · Brier @horizon.Value.HoldoutBrierScore?.ToString("0.000")</p>
                    }
                    @if (horizon.Value.RawHoldoutBrierScore is not null)
                    {
                        <p>Калибрация: @(horizon.Value.IsCalibrated ? CalibrationMethodLabel(horizon.Value.CalibrationMethod) : "недостигнат минимум данни") · @horizon.Value.CalibrationRows OOF реда · Brier @horizon.Value.RawHoldoutBrierScore.Value.ToString("0.000") → @horizon.Value.HoldoutBrierScore?.ToString("0.000") · ECE @horizon.Value.HoldoutExpectedCalibrationError?.ToString("0.000")</p>
                    }
                    <small>@horizon.Value.Message</small>
                    @if (!string.IsNullOrWhiteSpace(horizon.Value.ModelVersion))
                    {
                        <small class="learning-model-version">@horizon.Value.ModelVersion</small>
                    }
                    @if (horizon.Value.TrainingState == "candidate_ready")
                    {
                        <small class="@(horizon.Value.ActivationEligible ? "candidate-eligible" : "")">@horizon.Value.ActivationReason</small>
                    }
                </article>
            }
        </div>
        @if (Learning.Status.RecommendedCandidate is { } recommended)
        {
            <div class="candidate-activation-card">
                <div class="candidate-activation-copy">
                    <span class="candidate-activation-kicker">НАЙ-ДОБЪР ДОПУСТИМ КАНДИДАТ</span>
                    <strong>@recommended.Horizon · @recommended.ModelVersion</strong>
                    <small>AUC @recommended.HoldoutAuc.ToString("0.000") · Brier @recommended.HoldoutBrierScore.ToString("0.000") / база @recommended.BaselineBrierScore.ToString("0.000") · Brier Skill @recommended.BrierSkillScore.ToString("P1")</small>
                    <small>@recommended.MaturedLabels узрели етикета · @(recommended.IsCalibrated ? CalibrationMethodLabel(recommended.CalibrationMethod) : "без калибрация")</small>
                    <span>Избран е сред всички запазени кандидати по Brier Skill и AUC. Активирането сменя модела за този хоризонт и архивира предишния, ако има такъв.</span>
                </div>
                <div class="candidate-activation-controls">
                    <label>
                        <span>Одобрил · име или номер на преглед</span>
                        <input @bind="ActivationApprover" maxlength="120" placeholder="напр. Име или REVIEW-123" disabled="@IsActivatingCandidate" />
                    </label>
                    <button class="candidate-activate-button" @onclick="ActivateBestCandidateAsync" disabled="@(IsActivatingCandidate || string.IsNullOrWhiteSpace(ActivationApprover))">
                        @(IsActivatingCandidate ? "Активиране…" : "Активирай кандидата")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="candidate-activation-empty">Няма нов кандидат, който в момента да покрива праговете за активиране.</div>
        }
        @if (!string.IsNullOrWhiteSpace(CandidateActivationNotice))
        {
            <div class="learning-message @(CandidateActivationNoticeIsError ? "activation-error" : "activation-success")">@CandidateActivationNotice</div>
        }
        @if (Learning.Status.ApprovalRequired)
        {
            <div class="learning-foot">Новите модели се обучават автоматично като кандидати. Активирането им изисква преглед и одобрение.</div>
        }
    }
</section>
