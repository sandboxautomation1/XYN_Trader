    {
        public bool IsFavorite { get; set; }
        public string Note { get; set; } = "";
    }

    private sealed class SignalOrderDraft
    {
        public decimal? VolumeLots { get; set; }
        public decimal? StopLoss { get; set; }
        public decimal? TakeProfit { get; set; }
    }

    private sealed record SignalOrderNotice(bool Succeeded, string Message);

    private sealed record LiveEntryAlert(
        GeneratedSignalCandidate Signal,
        decimal TriggerPrice,
        DateTimeOffset DetectedAtUtc);
